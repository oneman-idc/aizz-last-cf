{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aizz-last-cf",
  "main": "src/worker.ts",
  "compatibility_date": "2025-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true
    }
  ],
  "vars": {
    "AIZZ_VERSION": "0.6.6",
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "AIZZ_DB",
      "database_name": "aizz-db",
      "migrations_dir": "migrations","database_id": "e0902d50-6993-4a3a-93db-3c7f63cf1939"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AIZZ_STORAGE",
      "bucket_name": "aizz-storage","preview_bucket_name": "aizz-storage"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
